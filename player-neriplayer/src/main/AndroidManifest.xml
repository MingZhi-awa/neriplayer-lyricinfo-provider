<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="moe.ouom.neriplayer" />
    </queries>

    <application
        android:name="io.github.andrealtb.coloroslyrics.provider.settings102.ProviderModuleApplication"
        android:allowBackup="true"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeriProvider">

        <activity
            android:name=".NeriDebugSettingsActivity"
            android:exported="true"
            android:label="@string/debug_settings_activity_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
